dbURL=your-mongodb-connection-string
JWT_SECRET=your-jwt-secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-secret
# Required: PATCH /orders/:id/status needs this as x-admin-key header.
# Fulfilment is admin-only; buyers can never progress their own orders.
# ADMIN_KEY=a-long-random-string
# Deployment: public URL of the frontend (Vercel). Local dev needs nothing.
# CLIENT_URL=http://localhost:5173
# Set to "production" on Render so auth cookies use SameSite=None + Secure.
# NODE_ENV=development
